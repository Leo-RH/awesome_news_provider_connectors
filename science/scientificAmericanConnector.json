{
  "name": "Scientific American",
  "source": "https://www.scientificamerican.com",
  "paths": [
    "/latest/"
  ],
  "splitter": {
    "selector": "article[class*=articleListItem]"
  },
  "patterns": {
    "title": {
      "selector": "h2[class*=articleTitle]"
    },
    "description": {
      "selector": "div[class*=dek] p"
    },
    "date": {
      "selector": "span[class*=kickerMeta]"
    },
    "link": {
      "selector": "a[href]"
    },
    "topic": {
      "selector": "div[class*=kicker-]",
      "regex": "^(.+?)(?=[A-Z][a-z]+ \\d{1,2}, \\d{4}|$)"
    },
    "image": {
      "selector": "figure img",
      "attribute": [
        "src"
      ]
    }
  }
}
