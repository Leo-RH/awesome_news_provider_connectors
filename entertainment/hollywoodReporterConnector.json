{
  "name": "The Hollywood Reporter - TV",
  "source": "https://www.hollywoodreporter.com",
  "paths": [
    "/c/tv/tv-news/"
  ],
  "splitter": {
    "selector": "div.story:has(a.c-title__link)"
  },
  "patterns": {
    "title": {
      "selector": "a.c-title__link"
    },
    "description": {
      "selector": "p.c-dek"
    },
    "date": {
      "selector": "time.c-timestamp"
    },
    "link": {
      "selector": "a.c-title__link"
    },
    "topic": {
      "selector": "a.o-category-link, span.c-span a, span.c-span"
    },
    "image": {
      "selector": "img.c-lazy-image__img"
    }
  }
}
