{
  "name": "Omelete",
  "source": "https://www.omelete.com.br",
  "paths": [
    "/"
  ],
  "language": "pt",
  "timezone": "America/Sao_Paulo",
  "splitter": {
    "selector": "article.card:has(h2.card__title):has(a.card__link[href])",
    "exclude": "a.card__link[href*='/ficha/']"
  },
  "patterns": {
    "title": {
      "selector": "h2.card__title"
    },
    "link": {
      "selector": "a.card__link"
    },
    "topic": {
      "selector": "div.badge"
    },
    "image": {
      "selector": "figure.card__image img"
    }
  }
}
