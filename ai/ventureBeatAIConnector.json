{
  "name": "VentureBeat - AI",
  "source": "https://venturebeat.com",
  "paths": [
    "/category/ai/"
  ],
  "splitter": {
    "selector": "article:has(header h2 a)",
    "exclude_regex": "Presented by "
  },
  "patterns": {
    "title": {
      "selector": "header h2 a"
    },
    "description": {
      "selector": "div.line-clamp-3"
    },
    "date": {
      "selector": "time",
      "attribute": "datetime"
    },
    "link": {
      "selector": "header h2 a"
    },
    "image": {
      "selector": "figure img"
    }
  }
}
