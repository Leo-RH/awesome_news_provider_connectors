{
  "name": "Polygon",
  "source": "https://www.polygon.com",
  "paths": [
    "/news/"
  ],
  "splitter": {
    "selector": "div.display-card.article:has(h5.display-card-title a)"
  },
  "patterns": {
    "title": {
      "selector": "h5.display-card-title a"
    },
    "description": {
      "selector": "p.display-card-excerpt"
    },
    "date": {
      "selector": "span.display-card-date",
      "attribute": "data-b64-ts",
      "transform": "base64"
    },
    "link": {
      "selector": "h5.display-card-title a"
    },
    "image": {
      "selector": "a.dc-img-link img"
    }
  }
}
