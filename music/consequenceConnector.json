{
  "name": "Consequence",
  "source": "https://consequence.net",
  "paths": [
    "/category/music/"
  ],
  "splitter": {
    "selector": "div.card:has(h3 a)",
    "exclude": ".native-ad"
  },
  "patterns": {
    "title": {
      "selector": "h3 a"
    },
    "date": {
      "selector": "span.post-date"
    },
    "link": {
      "selector": "h3 a"
    },
    "image": {
      "selector": "img.wp-post-image"
    }
  }
}
