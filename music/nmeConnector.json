{
  "name": "NME",
  "source": "https://www.nme.com",
  "paths": [
    "/news/music"
  ],
  "splitter": {
    "selector": "article:has(h3 a)"
  },
  "patterns": {
    "title": {
      "selector": "h3 a"
    },
    "description": {
      "selector": "div.mt-3 p"
    },
    "date": {
      "selector": "time",
      "attribute": "datetime"
    },
    "link": {
      "selector": "h3 a"
    },
    "image": {
      "selector": "img"
    }
  }
}
