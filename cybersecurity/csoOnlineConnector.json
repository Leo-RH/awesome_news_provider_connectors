{
  "name": "CSO Online",
  "source": "https://www.csoonline.com",
  "paths": [
    "/news/"
  ],
  "splitter": {
    "selector": "a.content-row-article"
  },
  "patterns": {
    "title": {
      "selector": "h3.card__title"
    },
    "description": {
      "selector": "p.card__description"
    },
    "date": {
      "selector": "div.card__info > span"
    },
    "link": {
      "selector": "div.card[href]",
      "attribute": "href"
    },
    "topic": {
      "selector": "span.card__tag span.tag"
    },
    "image": {
      "selector": "img"
    }
  }
}
